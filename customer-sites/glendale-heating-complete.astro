      }

      .cta-button {
        padding: 15px 40px;
        font-size: 18px;
      }
    }

    /* ACCESSIBILITY */
    a:focus, button:focus {
      outline: 2px solid #FF6B35;
      outline-offset: 2px;
    }

    h1, h2, h3 {
