---
import { client, tel, t, isMicro, type Lang } from "../lib/client";
const { lang = "en" as Lang } = Astro.props;
const c = t(lang);
const links = [
  { href: "/services", label: lang === "es" ? "Servicios" : "Services" },
  { href: "/about", label: lang === "es" ? "Nosotros" : "About" },
  { href: "/#area", label: lang === "es" ? "Zona" : "Service area" },
  { href: "/contact", label: lang === "es" ? "Contacto" : "Contact" },
].filter((l) => !(isMicro && (l.href === "/about" || l.href === "/#area")));
---

<header class="sticky top-0 z-40 border-b border-[var(--color-line)] bg-white/85 backdrop-blur">
  <div class="container flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg text-sm"
        style="background:var(--brand);color:var(--brand-ink)"
        aria-hidden="true"
      >
        {client.business.name.slice(0, 1)}
      </span>
      <span class="text-[1.05rem]">{client.business.name}</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-[var(--color-ink-soft)] md:flex">
      {links.map((l) => <a href={l.href} class="hover:text-[var(--color-ink)]">{l.label}</a>)}
    </nav>

    <a href={`tel:${tel}`} class="btn btn-primary !px-4 !py-2 text-sm">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.3 1z"
          fill="currentColor"
        />
      </svg>
      <span class="hidden sm:inline">{c.primaryCta}</span>
      <span class="sm:hidden">{lang === "es" ? "Llamar" : "Call"}</span>
    </a>
  </div>
</header>
