---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang } = Astro.props;
const c = t(lang);
const title = lang === "es" ? "Lo que dicen los clientes" : "What customers say";
---

<section class="section" id="reviews">
  <div class="container">
    <h2 class="text-3xl md:text-4xl animate-fade-in-up">{title}</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {c.reviews.map((r, i) => (
        <figure class="testimonial-alive card-premium reveal p-6 animate-fade-in-up" style={`animation-delay:${i * 80}ms`}>
          <div class="mb-4 flex gap-1" style="color:var(--brand-accent)" aria-hidden="true">
            {Array.from({ length: 5 }).map((_, idx) => (
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="star-alive"
                style={`animation: scale-up 0.5s var(--ease-bounce) forwards; animation-delay:${idx * 80}ms`}
              >
                <path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.4 3.3L6.8 14 1.8 9.1l7-.9z" />
              </svg>
            ))}
          </div>
          <blockquote class="testimonial-quote text-lg text-[var(--color-ink)] leading-relaxed italic">
            "{r.quote}"
          </blockquote>
          <figcaption class="mt-4 text-sm font-medium text-[var(--color-ink-soft)]">
            <span class="author-name block">{r.author}</span>
            {r.location && <span class="text-xs">{r.location}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
