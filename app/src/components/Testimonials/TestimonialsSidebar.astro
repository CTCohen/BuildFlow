---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang } = Astro.props;
const c = t(lang);
const title = lang === "es" ? "Lo que dicen los clientes" : "What customers say";

const [featured, ...rest] = c.reviews;
---

<section class="section" id="reviews">
  <div class="container">
    <h2 class="text-3xl md:text-4xl">{title}</h2>
    <div class="mt-10">
      {featured && (
        <div class="grid gap-8 md:grid-cols-3 mb-12">
          <div class="flex flex-col justify-center">
            <div class="flex gap-0.5 mb-4" style="color:var(--brand-accent)" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.4 3.3L6.8 14 1.8 9.1l7-.9z" />
                </svg>
              ))}
            </div>
            <figcaption class="text-lg font-semibold text-[var(--color-ink)]">
              {featured.author}
            </figcaption>
            {featured.location && (
              <p class="text-sm text-[var(--color-ink-soft)]">{featured.location}</p>
            )}
          </div>
          <figure class="card p-8 md:col-span-2">
            <blockquote class="text-lg text-[var(--color-ink)]">"{featured.quote}"</blockquote>
          </figure>
        </div>
      )}

      {rest.length > 0 && (
        <div class="mt-12 pt-12 border-t border-[var(--color-surface-2)]">
          <h3 class="text-lg font-semibold mb-6">{lang === "es" ? "Más testimonios" : "More reviews"}</h3>
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((r) => (
              <figure class="card reveal p-6">
                <div class="mb-3 flex gap-0.5" style="color:var(--brand-accent)" aria-hidden="true">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.4 3.3L6.8 14 1.8 9.1l7-.9z" />
                    </svg>
                  ))}
                </div>
                <blockquote class="text-[var(--color-ink)]">"{r.quote}"</blockquote>
                <figcaption class="mt-3 text-sm text-[var(--color-ink-soft)]">
                  — {r.author}{r.location ? `, ${r.location}` : ""}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
