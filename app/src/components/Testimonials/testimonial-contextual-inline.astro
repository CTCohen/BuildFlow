---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang } = Astro.props;
const c = t(lang);
const title = lang === "es" ? "Lo que dicen nuestros clientes" : "Our customers love us";
---

<section class="section" id="reviews">
  <div class="container">
    <h2 class="text-2xl md:text-3xl mb-10 text-center">{title}</h2>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
      {c.reviews.map((r) => (
        <div class="reveal flex flex-col">
          {/* Compact quote block */}
          <div class="flex-1">
            <div class="flex gap-0.5 mb-3" style="color:var(--brand-accent)" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                  <path d="m12 2 3 6.5 7 .9-5 4.9 1.2 7L12 18l-6.4 3.3L6.8 14 1.8 9.1l7-.9z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-sm text-[var(--color-ink)] mb-4 leading-snug italic">
              "{r.quote}"
            </blockquote>
          </div>

          {/* Author bar at bottom */}
          <div
            class="pt-4 border-t border-[var(--color-line)] flex items-start gap-3"
          >
            <div
              class="w-8 h-8 rounded-full flex-shrink-0"
              style="background: var(--brand-accent); opacity: 0.15"
              aria-hidden="true"
            ></div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-[var(--color-ink)] truncate">
                {r.author}
              </p>
              {r.location && (
                <p class="text-xs text-[var(--color-ink-soft)] truncate">{r.location}</p>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    {/* Social proof line */}
    <div class="mt-10 pt-8 border-t border-[var(--color-line)] text-center">
      <p class="text-sm text-[var(--color-ink-soft)]">
        {lang === "es"
          ? `⭐ Valorado con 4.9/5 por ${c.reviews.length} clientes satisfechos`
          : `⭐ Rated 4.9/5 by ${c.reviews.length} happy customers`
        }
      </p>
    </div>
  </div>
</section>
