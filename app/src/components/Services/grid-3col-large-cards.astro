---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang, heading } = Astro.props;
const c = t(lang);
const title = heading ?? (lang === "es" ? "Lo que hacemos" : "What we do");
---

<section class="section" id="services">
  <div class="container">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl">{title}</h2>
      <p class="mt-3 text-lg text-[var(--color-ink-soft)]">
        {lang === "es" ? "Explora nuestros servicios premium" : "Explore our premium services"}
      </p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {c.services.map((s, i) => {
        const slug = s.slug || s.name.toLowerCase().replace(/[^\w]+/g, "-");
        return (
          <a href={`/services/${slug}`} class="card reveal group overflow-hidden hover:shadow-xl transition-all" style={`transition-delay:${i * 60}ms`}>
            <!-- Background gradient header -->
            <div class="h-32 bg-gradient-to-br from-[var(--brand)] via-[var(--brand-accent)] to-[var(--brand)] relative overflow-hidden">
              <div class="absolute inset-0 opacity-20 group-hover:opacity-40 transition-opacity" style="background-image:radial-gradient(circle at 30% 40%, #fff, transparent 40%),radial-gradient(circle at 70% 70%, #fff, transparent 40%)"></div>
              <div class="absolute inset-0 flex items-center justify-center">
                <div class="h-16 w-16 rounded-2xl flex items-center justify-center bg-white/10 group-hover:bg-white/20 transition-colors">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" stroke-linecap="round">
                    <path d="M4 7h16M4 12h16M4 17h10" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Content -->
            <div class="p-8">
              <h3 class="text-2xl font-bold text-[var(--color-ink)] group-hover:text-[var(--brand)] transition-colors">
                {s.name}
              </h3>
              <p class="mt-4 text-[var(--color-ink-soft)] leading-relaxed">
                {s.blurb}
              </p>

              <!-- Additional description if available -->
              {s.description && (
                <p class="mt-4 text-sm text-[var(--color-ink-soft)]">
                  {s.description}
                </p>
              )}

              <!-- Call to action -->
              <div class="mt-6 flex items-center gap-2 text-[var(--brand)] font-semibold group-hover:gap-3 transition-all">
                <span>Learn more</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            </div>

            <!-- Bottom accent line -->
            <div class="h-1 bg-gradient-to-r from-[var(--brand)] to-[var(--brand-accent)] group-hover:h-2 transition-all"></div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .reveal {
    animation: revealUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
