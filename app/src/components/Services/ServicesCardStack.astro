---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang, heading } = Astro.props;
const c = t(lang);
const title = heading ?? (lang === "es" ? "Lo que hacemos" : "What we do");
---

<section class="section" id="services">
  <div class="container max-w-2xl">
    <h2 class="text-3xl md:text-4xl">{title}</h2>
    <div class="mt-10 flex flex-col gap-6">
      {c.services.map((s, i) => {
        const slug = s.slug || s.name.toLowerCase().replace(/[^\w]+/g, "-");
        return (
          <a href={`/services/${slug}`} class="card reveal p-8 hover:shadow-lg transition-shadow" style={`transition-delay:${i * 60}ms`}>
            <div
              class="mb-4 grid h-14 w-14 place-items-center rounded-xl"
              style="background:color-mix(in srgb,var(--brand) 12%, #fff);color:var(--brand)"
              aria-hidden="true"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              </svg>
            </div>
            <h3 class="text-xl font-semibold">{s.name}</h3>
            <p class="mt-3 text-[var(--color-ink-soft)]">{s.blurb}</p>
          </a>
        );
      })}
    </div>
  </div>
</section>
