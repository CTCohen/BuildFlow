---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang, heading } = Astro.props;
const c = t(lang);
const title = heading ?? (lang === "es" ? "Lo que hacemos" : "What we do");

const services = c.services;
const [featured, ...rest] = services;
---

<section class="section" id="services">
  <div class="container">
    <h2 class="text-3xl md:text-4xl">{title}</h2>
    <div class="mt-10 grid gap-5 lg:grid-cols-3">
      {featured && (
        <a href={`/services/${featured.slug || featured.name.toLowerCase().replace(/[^\w]+/g, "-")}`} class="card reveal p-8 hover:shadow-lg transition-shadow lg:col-span-2 lg:row-span-1">
          <div
            class="mb-4 grid h-16 w-16 place-items-center rounded-xl"
            style="background:color-mix(in srgb,var(--brand) 12%, #fff);color:var(--brand)"
            aria-hidden="true"
          >
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
              <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="text-2xl font-semibold">{featured.name}</h3>
          <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{featured.blurb}</p>
        </a>
      )}
      {rest.map((s, i) => {
        const slug = s.slug || s.name.toLowerCase().replace(/[^\w]+/g, "-");
        return (
          <a href={`/services/${slug}`} class="card reveal p-6 hover:shadow-lg transition-shadow" style={`transition-delay:${(i + 1) * 60}ms`}>
            <div
              class="mb-4 grid h-11 w-11 place-items-center rounded-xl"
              style="background:color-mix(in srgb,var(--brand) 12%, #fff);color:var(--brand)"
              aria-hidden="true"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold">{s.name}</h3>
            <p class="mt-2 text-[var(--color-ink-soft)]">{s.blurb}</p>
          </a>
        );
      })}
    </div>
  </div>
</section>
