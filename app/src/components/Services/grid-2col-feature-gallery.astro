---
import { t, type Lang } from "../../lib/client";

const { lang = "en" as Lang, heading } = Astro.props;
const c = t(lang);
const title = heading ?? (lang === "es" ? "Lo que hacemos" : "What we do");

const services = c.services;
const [featured, ...rest] = services;
---

<section class="section" id="services">
  <div class="container">
    <h2 class="text-3xl md:text-4xl">{title}</h2>

    <!-- Featured service gallery item -->
    {featured && (
      <div class="mt-12 grid gap-8 lg:grid-cols-3">
        <a href={`/services/${featured.slug || featured.name.toLowerCase().replace(/[^\w]+/g, "-")}`} class="card reveal overflow-hidden hover:shadow-lg transition-shadow lg:col-span-2 group">
          <!-- Gallery image placeholder -->
          <div class="relative aspect-video bg-gradient-to-br from-[var(--brand-accent)] to-[var(--brand)] overflow-hidden">
            <div class="absolute inset-0 opacity-10 group-hover:opacity-20 transition-opacity" style="background-image:radial-gradient(circle at 30% 40%, #fff, transparent 50%),radial-gradient(circle at 70% 65%, #fff, transparent 50%)"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" class="text-white opacity-50" stroke="currentColor" stroke-width="1.5">
                <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round" />
              </svg>
            </div>
          </div>

          <!-- Content -->
          <div class="p-8">
            <div class="inline-flex items-center justify-center h-14 w-14 rounded-xl mb-4" style="background:color-mix(in srgb,var(--brand) 12%, #fff);color:var(--brand)">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
              </svg>
            </div>
            <h3 class="text-2xl font-semibold">{featured.name}</h3>
            <p class="mt-3 text-lg text-[var(--color-ink-soft)]">{featured.blurb}</p>
            <p class="mt-4 text-sm font-medium text-[var(--brand)] group-hover:underline">Learn more →</p>
          </div>
        </a>

        <!-- Rest of services in compact card grid -->
        <div class="flex flex-col gap-4">
          {rest.map((s, i) => {
            const slug = s.slug || s.name.toLowerCase().replace(/[^\w]+/g, "-");
            return (
              <a href={`/services/${slug}`} class="card p-5 hover:shadow-lg transition-shadow reveal" style={`transition-delay:${(i + 1) * 60}ms`}>
                <div class="flex items-start gap-3">
                  <div class="flex-shrink-0 mt-1">
                    <div class="h-9 w-9 rounded-lg flex items-center justify-center" style="background:color-mix(in srgb,var(--brand) 12%, #fff);color:var(--brand)">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M4 7h16M4 12h16M4 17h10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                      </svg>
                    </div>
                  </div>
                  <div class="flex-1">
                    <h4 class="font-semibold text-sm">{s.name}</h4>
                    <p class="mt-1 text-xs text-[var(--color-ink-soft)] line-clamp-2">{s.blurb}</p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .reveal {
    animation: revealUp 0.6s ease-out forwards;
    opacity: 0;
  }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
