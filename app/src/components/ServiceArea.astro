---
import { client, type Lang } from "../lib/client";
const { lang = "en" as Lang } = Astro.props;
const biz = client.business;
const title = lang === "es" ? "Zona de servicio" : "Service area";
const lead =
  lang === "es"
    ? `Con base en ${biz.cityState}. Atendemos:`
    : `Based in ${biz.cityState}. We serve:`;
---

<section class="section bg-[var(--color-surface-2)]" id="area">
  <div class="container grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center">
    <div>
      <h2 class="text-3xl md:text-4xl">{title}</h2>
      <p class="mt-3 text-[var(--color-ink-soft)]">{lead}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {biz.serviceAreas.map((a) => (
          <li class="rounded-full border border-[var(--color-line)] bg-white px-3 py-1 text-sm">{a}</li>
        ))}
      </ul>
      <p class="mt-5 text-sm text-[var(--color-ink-soft)]">
        {lang === "es" ? "Horario: " : "Hours: "}{biz.hours}
      </p>
    </div>
    <div
      class="aspect-[16/10] rounded-[var(--radius-xl)] border border-[var(--color-line)]"
      style="background:
        radial-gradient(circle at 30% 40%, color-mix(in srgb,var(--brand) 20%, #fff), transparent 45%),
        radial-gradient(circle at 70% 65%, color-mix(in srgb,var(--brand-accent) 22%, #fff), transparent 45%),
        #fff"
      role="img"
      aria-label={`Map of ${biz.serviceAreas.join(", ")}`}
    >
    </div>
  </div>
</section>
