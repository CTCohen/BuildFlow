---
import Base from "../layouts/Base.astro";
import { tel, t } from "../lib/client";
const c = t("en");
---

<Base title="Page not found" path="/404">
  <section class="section">
    <div class="container max-w-xl text-center">
      <h1 class="text-4xl">Page not found</h1>
      <p class="mt-3 text-[var(--color-ink-soft)]">
        The page you were looking for isn’t here.
      </p>
      <div class="mt-6 flex justify-center gap-3">
        <a href="/" class="btn btn-primary">Back home</a>
        <a href={`tel:${tel}`} class="btn btn-ghost">{c.primaryCta}</a>
      </div>
    </div>
  </section>
</Base>
