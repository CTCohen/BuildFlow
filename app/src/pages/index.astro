---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero/index.astro";
import Services from "../components/Services/index.astro";
import About from "../components/About.astro";
import ServiceArea from "../components/ServiceArea.astro";
import Testimonials from "../components/Testimonials/index.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { isMicro } from "../lib/client";
---

<Base path="/">
  <Hero />
  <Services />
  {!isMicro && <About />}
  <Testimonials />
  {!isMicro && <ServiceArea />}
  <QuoteForm />
</Base>
