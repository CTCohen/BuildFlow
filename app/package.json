{
  "name": "buildflow-sites",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Fornax multi-tenant website generator. One codebase; one client per build.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/inline-css.mjs dist",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "new-client": "node scripts/new-client.mjs",
    "knowledge": "node ../knowledge/compile.mjs",
    "knowledge:graph": "node ../knowledge/graph.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.17",
    "astro": "^5.6.1",
    "tailwindcss": "^4.0.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "lighthouse": "^13.4.1",
    "typescript": "^5.8.2"
  }
}
