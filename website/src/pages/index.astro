---
// BuildFlow Landing Page
import Layout from '../layouts/Layout.astro';
---

<Layout title="BuildFlow — Professional Websites for Service Businesses">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <h1>Professional websites on your doorstep</h1>
      <p class="tagline">We build your service business a modern website in 7 days, then host it, keep it optimized, and handle every update — for $99/month.</p>
      <div class="cta-buttons">
        <a href="#pricing" class="button button-primary">See Pricing</a>
        <a href="#results" class="button button-secondary">See Examples</a>
      </div>
      <p class="hero-note">No big upfront cost · Live in 7 days · Cancel anytime</p>
    </div>
  </section>

  <!-- Value Prop -->
  <section class="value-props">
    <h2>Why BuildFlow?</h2>
    <div class="props-grid">
      <div class="prop">
        <h3>⚡ Live in 7 days</h3>
        <p>Your website is up within a week. No months-long custom build, no project management.</p>
      </div>
      <div class="prop">
        <h3>🎯 Designed around your brand</h3>
        <p>We build around your logo, your services, and your service area — not a generic template.</p>
      </div>
      <div class="prop">
        <h3>🔧 We run it for you</h3>
        <p>Hosting, SSL, security, backups, ongoing local SEO. You never open a website editor.</p>
      </div>
      <div class="prop">
        <h3>✏️ Unlimited content edits</h3>
        <p>New service, new photos, updated hours — email us and we make the change. Included.</p>
      </div>
      <div class="prop">
        <h3>📞 Lead capture built in</h3>
        <p>Click-to-call, quote and contact forms routed straight to your phone and inbox.</p>
      </div>
      <div class="prop">
        <h3>🌐 English &amp; Spanish</h3>
        <p>Every site works equally well in both languages. Reach more customers in your area.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="how">
    <h2>How it works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h4>Start your plan</h4>
        <p>Pick Managed Growth and send us your business info — logo, photos, services, hours.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h4>We build it</h4>
        <p>Modern site designed around your brand, Google Business set up, call tracking wired in.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h4>You go live</h4>
        <p>Review, approve, launch — all within 7 days of starting.</p>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <h4>We keep it running</h4>
        <p>Ongoing SEO, security, and unlimited content edits. Monthly check-in. Forever.</p>
      </div>
    </div>
  </section>

  <!-- Results Section -->
  <section id="results" class="results">
    <h2>Real websites, real results</h2>
    <p class="section-subtitle">How service businesses use BuildFlow to get found online</p>

    <div class="case-studies">
      <div class="case-study">
        <div class="case-before-after">
          <div class="case-before">
            <h4>Before</h4>
            <p class="case-description">No website, or an outdated design from 2015</p>
            <p class="case-result">❌ Hard to find on Google</p>
            <p class="case-result">❌ Losing leads to competitors who show up first</p>
          </div>
          <div class="case-arrow">→</div>
          <div class="case-after">
            <h4>After</h4>
            <p class="case-description">Modern, mobile-first BuildFlow site — hosted and maintained</p>
            <p class="case-result">✅ Google-friendly, fast on every device</p>
            <p class="case-result">✅ Lead capture + call tracking live from day one</p>
          </div>
        </div>
        <p class="case-result-quote">
          <strong>HVAC contractor, Phoenix</strong> — "First week online, got calls straight from Google."
        </p>
      </div>

      <div class="case-study">
        <div class="case-before-after">
          <div class="case-before">
            <h4>Before</h4>
            <p class="case-description">Desktop-only builder site, broken contact form</p>
            <p class="case-result">❌ Mobile visitors bounce</p>
            <p class="case-result">❌ Nobody maintaining or updating it</p>
          </div>
          <div class="case-arrow">→</div>
          <div class="case-after">
            <h4>After</h4>
            <p class="case-description">BuildFlow mobile-first rebuild, kept current for them</p>
            <p class="case-result">✅ Fast on all devices</p>
            <p class="case-result">✅ Forms work; edits handled by email</p>
          </div>
        </div>
        <p class="case-result-quote">
          <strong>Plumbing company, Denver</strong> — "$99 a month and I never think about the website. It just works."
        </p>
      </div>

      <div class="case-study">
        <div class="case-before-after">
          <div class="case-before">
            <h4>Before</h4>
            <p class="case-description">Generic template that looked like every other contractor</p>
            <p class="case-result">❌ No trust signals</p>
            <p class="case-result">❌ Drifting down the rankings, unmaintained</p>
          </div>
          <div class="case-arrow">→</div>
          <div class="case-after">
            <h4>After</h4>
            <p class="case-description">Custom design around their logo &amp; brand, actively optimized</p>
            <p class="case-result">✅ Professional, trustworthy look</p>
            <p class="case-result">✅ Ongoing SEO keeps it competitive</p>
          </div>
        </div>
        <p class="case-result-quote">
          <strong>Electrical contractor, Austin</strong> — "Looks better than sites I've seen quoted at ten times the price."
        </p>
      </div>
    </div>

    <p class="samples-links">
      See full sample sites:
      <a href="/samples/hvac">HVAC</a> ·
      <a href="/samples/plumbing">Plumbing</a> ·
      <a href="/samples/cleaning">Cleaning</a>
    </p>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="pricing">
    <h2>Simple, transparent pricing</h2>
    <p class="section-subtitle">One plan for almost everyone. A one-time option if you'd rather host it yourself.</p>

    <div class="pricing-cards">
      <div class="pricing-card pricing-card-featured">
        <div class="badge">Recommended</div>
        <h3>Managed Growth</h3>
        <div class="price">$99<span class="price-unit">/mo</span></div>
        <p class="price-subtitle">or $990/year · optional $199 setup, waived for early customers</p>

        <ul class="features">
          <li>✅ Custom website built around your brand</li>
          <li>✅ Live in 7 days</li>
          <li>✅ Hosting, SSL, CDN, custom domain</li>
          <li>✅ Local &amp; AI search optimization, ongoing</li>
          <li>✅ Unlimited small content edits</li>
          <li>✅ Click-to-call + quote/contact forms</li>
          <li>✅ Google Business setup</li>
          <li>✅ Monthly check-in</li>
          <li>✅ Cancel anytime</li>
        </ul>

        <a href="mailto:hello@buildflow.com?subject=Start%20BuildFlow%20Managed%20Growth" class="button button-primary">Get Started</a>
      </div>

      <div class="pricing-card">
        <h3>Ownership</h3>
        <div class="price">$497<span class="price-unit"> one-time</span></div>
        <p class="price-subtitle">You host it yourself afterward</p>

        <ul class="features">
          <li>✅ Custom website, built in 7 days</li>
          <li>✅ Exported to your own hosting account</li>
          <li>✅ 1 month of transition support</li>
          <li>✅ You own the exported files</li>
          <li>➖ No ongoing SEO or edits after handoff</li>
          <li>➖ Hosting, domain &amp; email bills become yours</li>
          <li>➖ Updates and maintenance are on you</li>
        </ul>

        <a href="mailto:hello@buildflow.com?subject=BuildFlow%20Ownership%20plan" class="button button-secondary">Choose Ownership</a>
      </div>
    </div>

    <p class="pricing-note">
      Questions? Email <a href="mailto:hello@buildflow.com">hello@buildflow.com</a>.
      We onboard a limited number of new sites each month.
    </p>
  </section>

  <!-- Email Capture -->
  <section class="newsletter">
    <h2>Not ready yet?</h2>
    <p>Get one email a month on getting found online and turning your website into leads.</p>

    <form class="email-form" action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
      <input type="email" name="email" placeholder="your@email.com" required />
      <button type="submit" class="button button-primary">Subscribe</button>
    </form>
    <p class="email-note">No spam. Unsubscribe anytime.</p>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <h2>Frequently asked questions</h2>

    <div class="faq-item">
      <h4>What does the $99/month cover?</h4>
      <p>Everything: hosting, SSL, your custom domain, ongoing local and AI-search optimization, unlimited small content edits, lead-capture forms, and a monthly check-in. It's a service, not a one-time file — we keep the site working and competitive month after month.</p>
    </div>

    <div class="faq-item">
      <h4>Is there a long-term contract?</h4>
      <p>No. Managed Growth is month-to-month. Cancel any time by email; billing stops and the site goes offline at the end of your paid period. Your domain stays yours.</p>
    </div>

    <div class="faq-item">
      <h4>How long does it take to launch?</h4>
      <p>7 days from when you start your plan and send us your business info. We build it, you review and approve, we go live.</p>
    </div>

    <div class="faq-item">
      <h4>Who makes changes after launch?</h4>
      <p>We do. Email us "add a service" or "swap this photo" and we make the change — included in your plan, typically within two business days.</p>
    </div>

    <div class="faq-item">
      <h4>What about my domain?</h4>
      <p>If you have one, we point it at your new site. If you don't, we register one in your name (about $12/year). Either way, the domain is yours.</p>
    </div>

    <div class="faq-item">
      <h4>Do you guarantee leads?</h4>
      <p>No. We build and maintain the lead-capture machinery — a fast, optimized site with click-to-call and forms. Actual lead volume depends on your market, competition, and Google, which take time.</p>
    </div>

    <div class="faq-item">
      <h4>What if I'd rather own it outright?</h4>
      <p>Choose the Ownership plan: $497 one-time. We build the site and export it to your own hosting, with a month of transition support. After that there's no ongoing service — hosting, updates, and SEO are yours to manage.</p>
    </div>

    <div class="faq-item">
      <h4>What happens if I cancel Managed Growth later?</h4>
      <p>Billing stops and the site comes offline at the end of the period you've paid for. If you want to keep it, a one-time static export to your own host is available at Ownership pricing.</p>
    </div>
  </section>

  <!-- CTA Footer -->
  <section class="cta-footer">
    <h2>Ready to get online?</h2>
    <p>Your competitors already show up on Google. Let's get you live this week.</p>
    <div class="cta-buttons">
      <a href="mailto:hello@buildflow.com?subject=Let%27s%20build%20my%20website" class="button button-primary">Email Us</a>
      <a href="#pricing" class="button button-secondary">See Pricing Again</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 80px 20px;
    text-align: center;
    background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  }

  .hero h1 {
    font-size: 48px;
    line-height: 1.1;
    margin: 0 0 20px 0;
    font-weight: 800;
    letter-spacing: -1.5px;
  }

  .tagline {
    font-size: 18px;
    color: #666;
    margin: 0 auto 24px;
    max-width: 640px;
  }

  .hero-note {
    margin: 24px 0 0;
    font-size: 13px;
    color: #999;
    letter-spacing: 0.3px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 16px;
    display: inline-block;
  }

  .button-primary {
    background: #dc2626;
    color: white;
  }

  .button-primary:hover {
    background: #b91c1c;
    text-decoration: none;
  }

  .button-secondary {
    background: white;
    color: #333;
    border: 2px solid #e5e5e5;
  }

  .button-secondary:hover {
    border-color: #dc2626;
    color: #dc2626;
    text-decoration: none;
  }

  .value-props, .results, .pricing, .newsletter, .faq, .cta-footer, .how {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .value-props h2, .results h2, .pricing h2, .newsletter h2, .faq h2, .cta-footer h2, .how h2 {
    font-size: 36px;
    margin: 0 0 20px 0;
    text-align: center;
  }

  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 16px;
    margin: 0 0 40px 0;
  }

  .props-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .prop {
    padding: 24px;
    background: #f9f9f9;
    border-radius: 8px;
    border-left: 4px solid #dc2626;
  }

  .prop h3 {
    margin: 0 0 12px 0;
    font-size: 18px;
  }

  .prop p {
    margin: 0;
    color: #666;
    line-height: 1.5;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .step {
    text-align: center;
    padding: 24px;
  }

  .step-num {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 50%;
    background: #dc2626;
    color: white;
    font-weight: 800;
    margin: 0 auto 16px;
  }

  .step h4 {
    margin: 0 0 8px;
    font-size: 16px;
  }

  .step p {
    margin: 0;
    color: #666;
    font-size: 14px;
  }

  .case-studies {
    display: grid;
    gap: 32px;
    margin-top: 40px;
  }

  .case-study {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 32px;
  }

  .case-before-after {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
  }

  .case-before, .case-after {
    padding: 20px;
    background: #f9f9f9;
    border-radius: 6px;
  }

  .case-before h4, .case-after h4 {
    margin: 0 0 12px 0;
    font-size: 14px;
    font-weight: 600;
    color: #999;
    text-transform: uppercase;
  }

  .case-description {
    margin: 0 0 16px 0;
    font-weight: 600;
    color: #333;
  }

  .case-result {
    margin: 8px 0;
    font-size: 14px;
    color: #666;
  }

  .case-arrow {
    font-size: 24px;
    color: #dc2626;
    font-weight: bold;
  }

  .case-result-quote {
    font-size: 14px;
    color: #666;
    font-style: italic;
    margin: 0;
  }

  .samples-links {
    text-align: center;
    margin-top: 32px;
    color: #666;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .case-before-after {
      grid-template-columns: 1fr;
    }
    .case-arrow {
      display: none;
    }
  }

  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 40px;
    align-items: start;
  }

  .pricing-card {
    border: 2px solid #e5e5e5;
    border-radius: 8px;
    padding: 32px;
    position: relative;
  }

  .pricing-card-featured {
    border-color: #dc2626;
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: #dc2626;
    color: white;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }

  .pricing-card h3 {
    margin: 0 0 12px 0;
    font-size: 24px;
  }

  .price {
    font-size: 40px;
    font-weight: 800;
    color: #dc2626;
    margin: 16px 0 8px 0;
  }

  .price-unit {
    font-size: 16px;
    font-weight: 600;
    color: #999;
  }

  .price-subtitle {
    color: #666;
    margin: 0 0 24px 0;
    font-size: 14px;
  }

  .features {
    list-style: none;
    margin: 0 0 24px 0;
    padding: 0;
  }

  .features li {
    padding: 8px 0;
    color: #666;
    font-size: 14px;
  }

  .pricing-note {
    text-align: center;
    color: #666;
    margin-top: 32px;
  }

  .pricing-note a {
    color: #dc2626;
    text-decoration: none;
  }

  .newsletter {
    background: #f9f9f9;
    border-radius: 8px;
    text-align: center;
  }

  .email-form {
    display: flex;
    gap: 8px;
    margin: 24px auto;
    max-width: 500px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .email-form input {
    flex: 1;
    min-width: 200px;
    padding: 12px 16px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    font-size: 14px;
  }

  .email-note {
    font-size: 12px;
    color: #999;
    margin: 0;
  }

  .faq-item {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e5e5e5;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item h4 {
    margin: 0 0 12px 0;
    font-size: 16px;
  }

  .faq-item p {
    margin: 0;
    color: #666;
    line-height: 1.6;
  }

  .cta-footer {
    text-align: center;
    background: #f9f9f9;
    border-radius: 8px;
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 32px;
    }

    .tagline {
      font-size: 16px;
    }

    .value-props h2, .results h2, .pricing h2, .how h2 {
      font-size: 28px;
    }
  }
</style>
