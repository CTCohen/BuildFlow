---
// BuildFlow Landing Page
import Layout from '../layouts/Layout.astro';
---

<Layout title="BuildFlow — Your website, your leads, your CRM. Built for trades.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-content">
      <h1>Your website. Your leads. Your CRM. Built for trades.</h1>
      <p class="tagline">We build your site before you ask, show it to you with your own dashboard, and put it live in about a minute when you say yes. Plumbing, HVAC, electrical and roofing.</p>
      <div class="cta-buttons">
        <a href="#demo" class="button button-primary">See how it works</a>
        <a href="#pricing" class="button button-secondary">See pricing</a>
      </div>
      <p class="hero-note">Built for you first · Live in about a minute after you pay · No long-term contract on monthly plans</p>
    </div>
  </section>

  <!-- Value Prop -->
  <section class="value-props">
    <h2>Why BuildFlow?</h2>
    <div class="props-grid">
      <div class="prop">
        <h3>AI-designed for your trade</h3>
        <p>A site built around your logo, services and service area, checked for accessibility (WCAG 2.1 AA) and speed before you ever see it.</p>
      </div>
      <div class="prop">
        <h3>Leads that show up in your inbox</h3>
        <p>Click-to-call and quote forms deliver leads straight to you, with a dashboard to see and follow up on every one.</p>
      </div>
      <div class="prop">
        <h3>Easy CRM sync</h3>
        <p>On the SMB plan, new leads flow into your CRM automatically. HubSpot first, then Jobber, ServiceTitan, Housecall Pro and Successware.</p>
      </div>
      <div class="prop">
        <h3>We run it for you</h3>
        <p>Hosting, SSL, security updates and backups are handled. You never open a website editor.</p>
      </div>
      <div class="prop">
        <h3>Reviews on your site</h3>
        <p>Your Google reviews are pulled onto your site so new customers see the proof.</p>
      </div>
      <div class="prop">
        <h3>Honest about results</h3>
        <p>We build and maintain the lead-capture machinery. We don't promise a number of leads; results depend on your market.</p>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="demo" class="how">
    <h2>How it works</h2>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <h4>We build it first</h4>
        <p>We create a site for your business and check it before it reaches you.</p>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <h4>You see it, and your dashboard</h4>
        <p>You get a link to your site plus a preview of the dashboard that comes with your plan.</p>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <h4>Say yes and it goes live</h4>
        <p>Choose Managed (we host it) or Offboard (you take it). Pay, and your site is live in about a minute.</p>
      </div>
      <div class="step">
        <div class="step-num">4</div>
        <h4>Leads flow in</h4>
        <p>Every form submission lands in your dashboard and, on SMB, in your CRM.</p>
      </div>
    </div>
    <p class="samples-links">
      Sample sites (illustrative, not customers):
      <a href="/samples/hvac">HVAC</a> ·
      <a href="/samples/plumbing">Plumbing</a> ·
      <a href="/samples/cleaning">Cleaning</a>
    </p>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="pricing">
    <h2>Simple, transparent pricing</h2>
    <p class="section-subtitle">Your plan is matched to your business size, and you see it with your demo. Annual is 10 months for the price of 12. Prices may change for new customers.</p>

    <div class="pricing-cards">
      <div class="pricing-card">
        <h3>Micro</h3>
        <div class="price">$149<span class="price-unit">/mo</span></div>
        <p class="price-subtitle">or $1,490/year · or $499 one-time (Offboard)</p>
        <ul class="features">
          <li>✅ Professional site, 6-8 sections</li>
          <li>✅ Contact form with email lead alerts</li>
          <li>✅ Lead inbox and CSV export</li>
          <li>✅ Google reviews on your site</li>
          <li>✅ Edit your text, contact info and images</li>
          <li>✅ Hosting, SSL, custom domain</li>
        </ul>
        <a href="mailto:hello@buildflow.com?subject=BuildFlow%20Micro%20demo" class="button button-secondary">Get my demo</a>
      </div>

      <div class="pricing-card pricing-card-featured">
        <div class="badge">Most popular</div>
        <h3>SMB</h3>
        <div class="price">$249<span class="price-unit">/mo</span></div>
        <p class="price-subtitle">or $2,490/year · or $799 one-time (Offboard)</p>
        <ul class="features">
          <li>✅ Everything in Micro</li>
          <li>✅ Gallery, map, FAQ, seasonal offers, team profiles</li>
          <li>✅ Your colors and fonts within a design profile</li>
          <li>✅ Notes and a simple pipeline in your dashboard</li>
          <li>✅ CRM sync to your CRM</li>
          <li>✅ Monthly search optimization</li>
        </ul>
        <a href="mailto:hello@buildflow.com?subject=BuildFlow%20SMB%20demo" class="button button-primary">Get my demo</a>
      </div>

      <div class="pricing-card">
        <h3>Mid-Market</h3>
        <div class="price">$399<span class="price-unit">/mo</span></div>
        <p class="price-subtitle">or $3,990/year · or $1,299 one-time (Offboard)</p>
        <ul class="features">
          <li>✅ Everything in SMB</li>
          <li>✅ Multi-location, custom pipeline, lead scoring</li>
          <li>✅ Multiple CRMs</li>
          <li>➖ Not yet available: contact us to join the waitlist</li>
        </ul>
        <a href="mailto:hello@buildflow.com?subject=BuildFlow%20Mid-Market%20waitlist" class="button button-secondary">Join the waitlist</a>
      </div>
    </div>

    <p class="pricing-note">
      Managed means we host and maintain your site. Offboard means you take the site and domain and host it yourself, with no ongoing support.
      Questions? Email <a href="mailto:hello@buildflow.com">hello@buildflow.com</a>.
    </p>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <h2>Frequently asked questions</h2>

    <div class="faq-item">
      <h4>Is there a long-term contract?</h4>
      <p>Not on monthly plans: cancel any time and access continues to the end of the paid month. Annual plans are billed once and are non-refundable if you cancel early.</p>
    </div>

    <div class="faq-item">
      <h4>How fast does it go live?</h4>
      <p>Your site is built before you see it. After you pay, it goes live in about a minute, with your dashboard login in your email.</p>
    </div>

    <div class="faq-item">
      <h4>Who makes changes after launch?</h4>
      <p>You do, in your dashboard, within your plan. Micro edits text, contact info and images; SMB adds more control. We do not write custom code for individual customers.</p>
    </div>

    <div class="faq-item">
      <h4>What about my domain?</h4>
      <p>Your site is available at a BuildFlow subdomain right away. You can point your own domain at it; the domain stays yours.</p>
    </div>

    <div class="faq-item">
      <h4>Do you guarantee leads?</h4>
      <p>No. We build and maintain a fast, accessible site with click-to-call and forms. Lead volume depends on your market and search engines.</p>
    </div>

    <div class="faq-item">
      <h4>What does Offboard mean?</h4>
      <p>You pay once, take the site and the domain, and host it yourself. There is no ongoing support; we give you documentation and videos.</p>
    </div>

    <div class="faq-item">
      <h4>Is the site available in Spanish?</h4>
      <p>Not at launch. English first; Spanish is planned.</p>
    </div>
  </section>

  <!-- CTA Footer -->
  <section class="cta-footer">
    <h2>Want to see your site?</h2>
    <p>Ask for your demo and we'll show you your site and your dashboard.</p>
    <div class="cta-buttons">
      <a href="mailto:hello@buildflow.com?subject=Show%20me%20my%20BuildFlow%20demo" class="button button-primary">Get my demo</a>
      <a href="#pricing" class="button button-secondary">See pricing again</a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 80px 20px;
    text-align: center;
    background: linear-gradient(135deg, #f5f5f5 0%, #fafafa 100%);
  }

  .hero h1 {
    font-size: 48px;
    line-height: 1.1;
    margin: 0 0 20px 0;
    font-weight: 800;
    letter-spacing: -1.5px;
  }

  .tagline {
    font-size: 18px;
    color: #666;
    margin: 0 auto 24px;
    max-width: 640px;
  }

  .hero-note {
    margin: 24px 0 0;
    font-size: 13px;
    color: #999;
    letter-spacing: 0.3px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 16px;
    display: inline-block;
  }

  .button-primary {
    background: #dc2626;
    color: white;
  }

  .button-primary:hover {
    background: #b91c1c;
    text-decoration: none;
  }

  .button-secondary {
    background: white;
    color: #333;
    border: 2px solid #e5e5e5;
  }

  .button-secondary:hover {
    border-color: #dc2626;
    color: #dc2626;
    text-decoration: none;
  }

  .value-props, .results, .pricing, .newsletter, .faq, .cta-footer, .how {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .value-props h2, .results h2, .pricing h2, .newsletter h2, .faq h2, .cta-footer h2, .how h2 {
    font-size: 36px;
    margin: 0 0 20px 0;
    text-align: center;
  }

  .section-subtitle {
    text-align: center;
    color: #666;
    font-size: 16px;
    margin: 0 0 40px 0;
  }

  .props-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .prop {
    padding: 24px;
    background: #f9f9f9;
    border-radius: 8px;
    border-left: 4px solid #dc2626;
  }

  .prop h3 {
    margin: 0 0 12px 0;
    font-size: 18px;
  }

  .prop p {
    margin: 0;
    color: #666;
    line-height: 1.5;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .step {
    text-align: center;
    padding: 24px;
  }

  .step-num {
    width: 40px;
    height: 40px;
    line-height: 40px;
    border-radius: 50%;
    background: #dc2626;
    color: white;
    font-weight: 800;
    margin: 0 auto 16px;
  }

  .step h4 {
    margin: 0 0 8px;
    font-size: 16px;
  }

  .step p {
    margin: 0;
    color: #666;
    font-size: 14px;
  }

  .case-studies {
    display: grid;
    gap: 32px;
    margin-top: 40px;
  }

  .case-study {
    background: white;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 32px;
  }

  .case-before-after {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 20px;
  }

  .case-before, .case-after {
    padding: 20px;
    background: #f9f9f9;
    border-radius: 6px;
  }

  .case-before h4, .case-after h4 {
    margin: 0 0 12px 0;
    font-size: 14px;
    font-weight: 600;
    color: #999;
    text-transform: uppercase;
  }

  .case-description {
    margin: 0 0 16px 0;
    font-weight: 600;
    color: #333;
  }

  .case-result {
    margin: 8px 0;
    font-size: 14px;
    color: #666;
  }

  .case-arrow {
    font-size: 24px;
    color: #dc2626;
    font-weight: bold;
  }

  .case-result-quote {
    font-size: 14px;
    color: #666;
    font-style: italic;
    margin: 0;
  }

  .samples-links {
    text-align: center;
    margin-top: 32px;
    color: #666;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .case-before-after {
      grid-template-columns: 1fr;
    }
    .case-arrow {
      display: none;
    }
  }

  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 40px;
    align-items: start;
  }

  .pricing-card {
    border: 2px solid #e5e5e5;
    border-radius: 8px;
    padding: 32px;
    position: relative;
  }

  .pricing-card-featured {
    border-color: #dc2626;
  }

  .badge {
    position: absolute;
    top: -12px;
    left: 20px;
    background: #dc2626;
    color: white;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
  }

  .pricing-card h3 {
    margin: 0 0 12px 0;
    font-size: 24px;
  }

  .price {
    font-size: 40px;
    font-weight: 800;
    color: #dc2626;
    margin: 16px 0 8px 0;
  }

  .price-unit {
    font-size: 16px;
    font-weight: 600;
    color: #999;
  }

  .price-subtitle {
    color: #666;
    margin: 0 0 24px 0;
    font-size: 14px;
  }

  .features {
    list-style: none;
    margin: 0 0 24px 0;
    padding: 0;
  }

  .features li {
    padding: 8px 0;
    color: #666;
    font-size: 14px;
  }

  .pricing-note {
    text-align: center;
    color: #666;
    margin-top: 32px;
  }

  .pricing-note a {
    color: #dc2626;
    text-decoration: none;
  }

  .newsletter {
    background: #f9f9f9;
    border-radius: 8px;
    text-align: center;
  }

  .email-form {
    display: flex;
    gap: 8px;
    margin: 24px auto;
    max-width: 500px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .email-form input {
    flex: 1;
    min-width: 200px;
    padding: 12px 16px;
    border: 1px solid #e5e5e5;
    border-radius: 6px;
    font-size: 14px;
  }

  .email-note {
    font-size: 12px;
    color: #999;
    margin: 0;
  }

  .faq-item {
    margin-bottom: 32px;
    padding-bottom: 32px;
    border-bottom: 1px solid #e5e5e5;
  }

  .faq-item:last-child {
    border-bottom: none;
  }

  .faq-item h4 {
    margin: 0 0 12px 0;
    font-size: 16px;
  }

  .faq-item p {
    margin: 0;
    color: #666;
    line-height: 1.6;
  }

  .cta-footer {
    text-align: center;
    background: #f9f9f9;
    border-radius: 8px;
  }

  @media (max-width: 600px) {
    .hero h1 {
      font-size: 32px;
    }

    .tagline {
      font-size: 16px;
    }

    .value-props h2, .results h2, .pricing h2, .how h2 {
      font-size: 28px;
    }
  }
</style>
