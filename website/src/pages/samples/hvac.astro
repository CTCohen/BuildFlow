---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Phoenix HVAC Services - Professional Heating & Cooling">
  <section class="hero hero-hvac">
    <div class="hero-background">
      <div class="hero-overlay"></div>
    </div>
    <div class="hero-content">
      <h1>Professional HVAC Services in Phoenix</h1>
      <p class="tagline">Fast Response. Expert Solutions. 24/7 Availability.</p>
      <a href="#contact" class="cta-button">Get a Free Quote Today</a>
    </div>
  </section>

  <section class="services">
    <h2>Our Services</h2>
    <div class="services-grid">
      <div class="service-card">
        <h3>Air Conditioning Repair</h3>
        <p>Expert diagnosis and repair for all AC units. Same-day service available.</p>
      </div>
      <div class="service-card">
        <h3>Heating System Installation</h3>
        <p>Professional installation of energy-efficient heating systems for homes and businesses.</p>
      </div>
      <div class="service-card">
        <h3>Maintenance Plans</h3>
        <p>Regular maintenance to keep your system running efficiently year-round.</p>
      </div>
    </div>
  </section>

  <section class="testimonials">
    <h2>What Our Customers Say</h2>
    <div class="testimonials-grid">
      <div class="testimonial">
        <p class="stars">★★★★★</p>
        <p class="quote">"Called on a Saturday and they came out the same day. Fixed our AC in 2 hours. Best service in Phoenix!"</p>
        <p class="author">— Sarah Martinez, Homeowner</p>
      </div>
      <div class="testimonial">
        <p class="stars">★★★★★</p>
        <p class="quote">"Professional team, fair pricing, and they actually explained what was wrong. Highly recommend."</p>
        <p class="author">— Tom Anderson, Business Owner</p>
      </div>
    </div>
  </section>

  <section class="contact" id="contact">
    <h2>Ready to Get Started?</h2>
    <p>Call us today for a free quote or schedule online.</p>
    <div class="contact-buttons">
      <a href="tel:+16025551234" class="button-primary">Call Now: (602) 555-1234</a>
      <a href="#" class="button-secondary">Request a Quote</a>
    </div>
  </section>
</Layout>

<style>
  .hero-hvac {
    background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
    color: white;
    padding: 100px 20px;
    text-align: center;
  }

  .hero-overlay {
    display: none;
  }

  .hero-content h1 {
    font-size: 48px;
    margin-bottom: 16px;
  }

  .tagline {
    font-size: 20px;
    margin-bottom: 32px;
    opacity: 0.95;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 40px;
    background: white;
    color: #FF6B35;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    border-radius: 6px;
    transition: transform 0.3s;
  }

  .cta-button:hover {
    transform: scale(1.05);
  }

  .services {
    padding: 60px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .services h2 {
    font-size: 36px;
    margin-bottom: 40px;
    text-align: center;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .service-card {
    padding: 24px;
    background: #f9f9f9;
    border-radius: 8px;
    border-left: 4px solid #FF6B35;
  }

  .service-card h3 {
    margin-bottom: 12px;
    font-size: 18px;
  }

  .service-card p {
    color: #666;
    line-height: 1.6;
  }

  .testimonials {
    padding: 60px 20px;
    background: #f5f5f5;
  }

  .testimonials h2 {
    font-size: 36px;
    margin-bottom: 40px;
    text-align: center;
  }

  .testimonials-grid {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .testimonial {
    padding: 24px;
    background: white;
    border-radius: 8px;
  }

  .stars {
    font-size: 18px;
    color: #FF6B35;
    margin: 0 0 12px 0;
  }

  .quote {
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 12px;
    font-style: italic;
  }

  .author {
    font-size: 14px;
    color: #666;
    margin: 0;
  }

  .contact {
    padding: 60px 20px;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .contact h2 {
    font-size: 36px;
    margin-bottom: 16px;
  }

  .contact p {
    font-size: 18px;
    color: #666;
    margin-bottom: 32px;
  }

  .contact-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button-primary,
  .button-secondary {
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    font-size: 16px;
    border: none;
    cursor: pointer;
  }

  .button-primary {
    background: #FF6B35;
    color: white;
  }

  .button-primary:hover {
    background: #E55A24;
  }

  .button-secondary {
    background: white;
    color: #FF6B35;
    border: 2px solid #FF6B35;
  }

  .button-secondary:hover {
    background: #f9f9f9;
  }

  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 32px;
    }
    .tagline {
      font-size: 16px;
    }
  }
</style>
