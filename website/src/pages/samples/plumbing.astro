---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Denver Plumbing Services - Professional Plumbers">
  <section class="hero hero-plumbing">
    <div class="hero-content">
      <h1>Professional Plumbing Services in Denver</h1>
      <p class="tagline">Trusted Expertise. Fair Pricing. Available 24/7.</p>
      <a href="#contact" class="cta-button">Request an Estimate</a>
    </div>
  </section>

  <section class="services">
    <h2>What We Do</h2>
    <div class="services-list">
      <div class="service-item">
        <h3>Emergency Repairs</h3>
        <p>Burst pipes, leaks, and urgent issues. We're available 24/7 for emergencies.</p>
      </div>
      <div class="service-item">
        <h3>Drain Cleaning</h3>
        <p>Professional drain cleaning using advanced equipment. No harsh chemicals.</p>
      </div>
      <div class="service-item">
        <h3>Fixture Installation</h3>
        <p>Expert installation of faucets, toilets, showers, and other plumbing fixtures.</p>
      </div>
      <div class="service-item">
        <h3>Preventive Maintenance</h3>
        <p>Regular inspections and maintenance to prevent costly problems down the road.</p>
      </div>
    </div>
  </section>

  <section class="testimonials">
    <h2>Our Customers Love Us</h2>
    <div class="testimonials-list">
      <div class="testimonial-item">
        <div class="stars">★★★★★</div>
        <p>"Had a pipe burst on a Sunday. They came out in 30 minutes and fixed it right. Amazing service."</p>
        <p class="author">— James Wilson</p>
      </div>
      <div class="testimonial-item">
        <div class="stars">★★★★★</div>
        <p>"Been using them for 3 years. Always professional, honest pricing, never overcharge. Highly trusted."</p>
        <p class="author">— Lisa Chen</p>
      </div>
      <div class="testimonial-item">
        <div class="stars">★★★★★</div>
        <p>"Fixed our kitchen sink issue quickly. No drama, no upsell, just good honest work."</p>
        <p class="author">— David Rodriguez</p>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <h2>Need a Plumber?</h2>
    <p>Call us today or request an estimate online. Available 24/7 for emergencies.</p>
    <div class="cta-buttons">
      <a href="tel:+13035551234" class="button-primary">Call: (303) 555-1234</a>
      <a href="#contact" class="button-secondary">Get an Estimate</a>
    </div>
  </section>
</Layout>

<style>
  .hero-plumbing {
    background: linear-gradient(135deg, #1E3A5F 0%, #2E5090 100%);
    color: white;
    padding: 120px 20px;
    text-align: center;
  }

  .hero-content h1 {
    font-size: 48px;
    margin-bottom: 16px;
    font-weight: 800;
  }

  .tagline {
    font-size: 20px;
    margin-bottom: 32px;
    opacity: 0.9;
  }

  .cta-button {
    display: inline-block;
    padding: 16px 40px;
    background: #4A90A4;
    color: white;
    font-weight: 700;
    font-size: 16px;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.3s;
  }

  .cta-button:hover {
    background: #357A99;
  }

  .services {
    padding: 60px 20px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .services h2 {
    font-size: 36px;
    margin-bottom: 40px;
    text-align: center;
  }

  .services-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
  }

  .service-item {
    padding: 24px;
    border-left: 4px solid #1E3A5F;
  }

  .service-item h3 {
    font-size: 18px;
    margin-bottom: 12px;
    color: #1E3A5F;
  }

  .service-item p {
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  .testimonials {
    padding: 60px 20px;
    background: #f9f9f9;
  }

  .testimonials h2 {
    font-size: 36px;
    margin-bottom: 40px;
    text-align: center;
  }

  .testimonials-list {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .testimonial-item {
    padding: 24px;
    background: white;
    border-radius: 8px;
    border-top: 4px solid #1E3A5F;
  }

  .stars {
    font-size: 16px;
    color: #FFC107;
    margin-bottom: 12px;
  }

  .testimonial-item p {
    line-height: 1.6;
    color: #333;
    margin: 0 0 12px 0;
  }

  .author {
    font-size: 14px;
    color: #666;
    font-weight: 600;
  }

  .cta-section {
    padding: 60px 20px;
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-section h2 {
    font-size: 36px;
    margin-bottom: 16px;
  }

  .cta-section p {
    font-size: 18px;
    color: #666;
    margin-bottom: 32px;
  }

  .cta-buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button-primary,
  .button-secondary {
    padding: 14px 32px;
    border-radius: 6px;
    font-weight: 600;
    text-decoration: none;
    font-size: 16px;
    border: none;
    cursor: pointer;
  }

  .button-primary {
    background: #1E3A5F;
    color: white;
  }

  .button-primary:hover {
    background: #0F2236;
  }

  .button-secondary {
    background: white;
    color: #1E3A5F;
    border: 2px solid #1E3A5F;
  }

  .button-secondary:hover {
    background: #f0f0f0;
  }

  @media (max-width: 768px) {
    .hero-content h1 {
      font-size: 32px;
    }
    .tagline {
      font-size: 16px;
    }
  }
</style>
